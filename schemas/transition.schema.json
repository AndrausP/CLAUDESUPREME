{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestra.local/schemas/transition/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transition_id", "task_id", "expected_revision", "from", "to", "actor", "reason_code", "reason", "evidence_refs", "occurred_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "transition_id": {"type": "string", "format": "uuid"},
    "task_id": {"type": "string", "format": "uuid"},
    "expected_revision": {"type": "integer", "minimum": 0},
    "from": {"$ref": "#/$defs/status"},
    "to": {"$ref": "#/$defs/status"},
    "actor": {"type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": {"type": {"enum": ["user", "agent", "system"]}, "id": {"type": "string"}}},
    "reason_code": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "maxLength": 2000},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "occurred_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"status": {"enum": ["CREATED", "CLASSIFIED", "PLANNED", "READY", "RUNNING", "BLOCKED", "REVIEWING", "VALIDATING", "APPROVED", "REWORK_REQUIRED", "COMPLETED", "FAILED", "CANCELLED"]}}
}
