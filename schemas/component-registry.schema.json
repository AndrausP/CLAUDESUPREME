{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestra.local/schemas/component-registry/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component_id", "version", "type", "origin", "description", "permissions", "dependencies", "compatibility", "status", "checksum"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "component_id": {"type": "string"},
    "version": {"type": "string"},
    "type": {"enum": ["agent", "department", "skill", "mcp", "command", "hook", "validator", "workflow", "storage-provider"]},
    "origin": {"type": "object", "additionalProperties": false, "required": ["kind", "uri"], "properties": {"kind": {"enum": ["local", "marketplace", "git"]}, "uri": {"type": "string"}}},
    "description": {"type": "string"},
    "permissions": {"type": "object"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "compatibility": {"type": "object"},
    "status": {"enum": ["quarantined", "disabled", "enabled", "incompatible", "failed", "removed"]},
    "checksum": {"type": "object", "required": ["algorithm", "value"], "properties": {"algorithm": {"const": "sha256"}, "value": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "configuration_ref": {"type": ["string", "null"]}
  }
}
