{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestra.local/schemas/task/1.0.0",
  "title": "Orchestra Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "project_id", "correlation_id", "title", "objective", "mode", "risk", "status", "owner", "selected_agents", "rejected_candidates", "acceptance_criteria", "dependencies", "budget_profile", "revision", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "format": "uuid"},
    "parent_task_id": {"type": ["string", "null"], "format": "uuid"},
    "attempt_of": {"type": ["string", "null"], "format": "uuid"},
    "project_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "title": {"type": "string", "minLength": 1, "maxLength": 256},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "mode": {"enum": ["DIRECT", "LEAN", "STANDARD", "DEEP"]},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "status": {"enum": ["CREATED", "CLASSIFIED", "PLANNED", "READY", "RUNNING", "BLOCKED", "REVIEWING", "VALIDATING", "APPROVED", "REWORK_REQUIRED", "COMPLETED", "FAILED", "CANCELLED"]},
    "owner": {"type": "string", "minLength": 1},
    "selected_agents": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "rejected_candidates": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "acceptance_criteria": {"type": "array", "items": {"type": "object"}},
    "dependencies": {"type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
    "budget_profile": {"enum": ["ECONOMY", "BALANCED", "QUALITY", "CRITICAL"]},
    "revision": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason_code"],
      "properties": {"id": {"type": "string"}, "reason_code": {"type": "string"}}
    }
  }
}
