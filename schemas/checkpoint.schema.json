{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestra.local/schemas/checkpoint/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "checkpoint_id", "task_id", "attempt", "state", "step", "completed_units", "pending_units", "budget_snapshot", "artifact_refs", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "checkpoint_id": {"type": "string", "format": "uuid"},
    "task_id": {"type": "string", "format": "uuid"},
    "attempt": {"type": "integer", "minimum": 1},
    "state": {"type": "string"},
    "step": {"type": "string", "minLength": 1},
    "completed_units": {"type": "array", "items": {"type": "string"}},
    "pending_units": {"type": "array", "items": {"type": "string"}},
    "resume_after": {"type": ["string", "null"], "format": "date-time"},
    "budget_snapshot": {"type": "object"},
    "artifact_refs": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
