{
  "schema_version": "1.0.0",
  "profile": "CRITICAL",
  "limits": {
    "max_agent_runs": 8,
    "max_parallel_agents": 3,
    "max_retries_per_step": 3,
    "max_rework_cycles": 3,
    "max_duration_seconds": 10800,
    "max_artifact_bytes": 25000000,
    "max_tokens": null
  },
  "enforcement": {
    "max_tokens": "advisory-when-unobserved",
    "safety_minimums": "always"
  }
}
