{
  "schema_version": "1.0.0",
  "profile": "BALANCED",
  "limits": {
    "max_agent_runs": 3,
    "max_parallel_agents": 2,
    "max_retries_per_step": 2,
    "max_rework_cycles": 2,
    "max_duration_seconds": 3600,
    "max_artifact_bytes": 10485760,
    "max_tokens": null
  },
  "enforcement": {
    "max_tokens": "advisory-when-unobserved",
    "safety_minimums": "always"
  }
}
