{
  "schema_version": "1.0.0",
  "profile": "ECONOMY",
  "limits": {
    "max_agent_runs": 1,
    "max_parallel_agents": 1,
    "max_retries_per_step": 1,
    "max_rework_cycles": 1,
    "max_duration_seconds": 900,
    "max_artifact_bytes": 2000000,
    "max_tokens": null
  },
  "enforcement": {
    "max_tokens": "advisory-when-unobserved",
    "safety_minimums": "always"
  }
}
